    <!-- ==========================================
         JAVASCRIPT LOGIC (ACCORDIONS & FUNNEL)
    =========================================== -->
    <script>
        // --- 1. ACCORDION LOGIC ---
        function toggleAccordion(contentId, iconId) {
            const content = document.getElementById(contentId);
            const icon = document.getElementById(iconId);
            
            // Toggle active classes
            if (content.classList.contains('active')) {
                content.classList.remove('active');
                icon.classList.remove('active');
            } else {
                content.classList.add('active');
                icon.classList.add('active');
            }
        }

        // --- 2. FUNNEL / CART LOGIC ---
        // Set your WhatsApp Number Here (Include country code, no + or spaces)
        const WHATSAPP_NUMBER = "2349039641174"; // <-- CHANGE THIS NUMBER

        let cart = {
            book: true,
            upsell1: false,
            downsell: false,
            upsell2: false
        };

        const prices = {
            book: 15000,
            upsell1: 50000,
            downsell: 25000,
            upsell2: 50000
        };

        function showSection(sectionId) {
            document.getElementById('step-landing').classList.add('hidden');
            document.getElementById('step-upsell-1').classList.add('hidden');
            document.getElementById('step-downsell').classList.add('hidden');
            document.getElementById('step-upsell-2').classList.add('hidden');
            
            document.getElementById(sectionId).classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function showToast(message) {
            const toast = document.getElementById('cart-toast');
            document.getElementById('toast-message').innerText = message;
            
            toast.classList.remove('hidden', 'toast-exit');
            toast.classList.add('flex', 'toast-enter');
            
            setTimeout(() => {
                toast.classList.remove('toast-enter');
                toast.classList.add('toast-exit');
                setTimeout(() => toast.classList.add('hidden'), 500);
            }, 2000);
        }

        function startCheckout() { showSection('step-upsell-1'); }

        function acceptUpsell1() {
            cart.upsell1 = true;
            showToast("Clarity Session Added!");
            setTimeout(() => showSection('step-upsell-2'), 1000); 
        }

        function declineUpsell1() { showSection('step-downsell'); }

        function acceptDownsell() {
            cart.downsell = true;
            showToast("The Vault Added!");
            setTimeout(() => showSection('step-upsell-2'), 1000);
        }

        function declineDownsell() { checkoutToWhatsApp(); }

        function acceptUpsell2() {
            cart.upsell2 = true;
            showToast("DFY Execution Added!");
            setTimeout(() => checkoutToWhatsApp(), 1000);
        }

        function declineUpsell2() { checkoutToWhatsApp(); }

        function checkoutToWhatsApp() {
            let total = prices.book;
            let items =["👉 Doubt to Domination Manual (₦15,000)"];

            if(cart.upsell1) { total += prices.upsell1; items.push("👉 EQSP 60-Min Clarity Session (₦50,000)"); }
            if(cart.downsell) { total += prices.downsell; items.push("👉 The Domination Vault (₦25,000)"); }
            if(cart.upsell2) { total += prices.upsell2; items.push("👉 DFY 30-Day Execution (₦50,000)"); }

            let text = `Hello Joshua! I'm ready to initiate the factory reset. Here is my order:\n\n${items.join('\n')}\n\n*TOTAL DUE: ₦${total.toLocaleString()}*\n\nPlease send me the account details to secure my access.`;
            
            let url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`;
            window.location.href = url;
        }
    </script>
</body>
</html>
